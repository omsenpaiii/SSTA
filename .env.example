NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google reCAPTCHA v2
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Supabase Auth + Admin allowlist
SSTA_ADMIN_EMAILS=admin@ssta.net.au,omtomar4882@gmail.com,Agastyakapoor40@gmail.com


# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer key name if you prefer Supabase publishable keys.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable Google provider and email/password in Supabase Auth.

# Pinch Payments
# Use PINCH_MODE=test locally; switch to live only after the Pinch merchant account is approved.
PINCH_MODE=test
PINCH_CLIENT_ID=
PINCH_SECRET_KEY=
PINCH_WEBHOOK_SECRET=
# Optional: enables the CPP20218 locked-assignment "Unlock with Pinch" button.
CPP20218_ASSIGNMENT_UNLOCK_AMOUNT_CENTS=

# Legacy Stripe fallback/webhook code may remain in old deployments, but Pinch is the active checkout path.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Enrollment intake email
SMTP_HOST=mail.ssta.net.au
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@ssta.net.au
SMTP_PASSWORD=
SMTP_FROM=admin@ssta.net.au
ENROLLMENT_TO_EMAIL=admin@ssta.net.au
